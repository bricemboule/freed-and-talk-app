APP_ENV=development

DATABASE_URL=
JWT_SECRET_KEY=
OTP_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# file : emails .eml consultables dans .local/mail (développement uniquement).
# smtp : envoi vers un serveur SMTP, obligatoire en production.
EMAIL_BACKEND=file
MAIL_DIRECTORY=.local/mail
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_SSL=true
SMTP_STARTTLS=false
REDIS_URL=


MEDIA_DIRECTORY=.local/media
PRIVATE_DOCUMENTS_DIRECTORY=.local/private/documents
AVATAR_MAX_BYTES=5242880
DOCUMENT_MAX_BYTES=5242880
REQUIRED_PROFESSIONAL_DOCUMENTS=identity_document,diploma


APPOINTMENT_TIMEZONE=Africa/Douala
CONSULTATION_DEFAULT_MINUTES=45
CONSULTATION_ALLOWED_MINUTES=30,45,60
APPOINTMENT_SLOT_STEP_MINUTES=15
APPOINTMENT_MAX_ADVANCE_DAYS=180
APPOINTMENT_CANCEL_NOTICE_MINUTES=60
CONSULTATION_EARLY_JOIN_MINUTES=15
CONSULTATION_ACCESS_GRACE_MINUTES=15
MEETING_TOKEN_MINUTES=5


JITSI_BASE_URL=
JITSI_APP_ID=
JITSI_JWT_SECRET=
JITSI_JWT_SUBJECT=
JITSI_JWT_AUDIENCE=

# Messagerie et notifications en application.
MESSAGE_MAX_CHARACTERS=10000
MESSAGE_EDIT_MINUTES=10
MESSAGE_RATE_LIMIT=30
MESSAGE_ATTACHMENT_MAX_BYTES=5242880
PRIVATE_MESSAGE_DIRECTORY=.local/private/messages
APPOINTMENT_REMINDER_MINUTES=60

# Fichiers PDF/audio/vidéo de la bibliothèque publique, stockés hors du webroot.
RESOURCE_MAX_BYTES=26214400
PRIVATE_RESOURCE_DIRECTORY=.local/private/resources
